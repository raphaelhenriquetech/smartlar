    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const FUSO = 'America/Sao_Paulo';\n// Aceita ISO (PostgREST: 2026-10-03T12:00:00+00:00) e texto do Postgres (2026-10-03 12:00:00+00).\nconst emSP = (valor, formato) => {\n  if (!valor) return '';\n  let data = DateTime.fromISO(valor);\n  if (!data.isValid) data = DateTime.fromSQL(valor);\n  return data.isValid ? data.setZone(FUSO).toFormat(formato) : String(valor);\n};\n\nconst PAGAMENTO = {\n  pix: 'Pix',\n  cartao_credito: 'Cartão de crédito',\n  cartao_debito: 'Cartão de débito',\n  boleto: 'Boleto',\n  dinheiro: 'Dinheiro',\n};\n\nreturn $input.all().map(({ json: p }) => ({\n  json: {\n    'Data da conclusão': emSP(p.concluido_em ?? p.updated_at, 'dd/MM/yyyy HH:mm'),\n    'Pedido': p.numero,\n    'Cliente': p.cliente_nome,\n    'Valor': Number(p.valor_total),\n    'Forma de pagamento': PAGAMENTO[p.forma_pagamento] ?? p.forma_pagamento ?? '',\n    'Técnico': p.tecnico_nome ?? '',\n  },\n}));"
      },
      "id": "21d46442-756a-478c-a0e3-caa805c6052c",
