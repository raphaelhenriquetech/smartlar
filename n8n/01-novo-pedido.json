    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const FUSO = 'America/Sao_Paulo';\n// Aceita ISO (PostgREST: 2026-10-03T12:00:00+00:00) e texto do Postgres (2026-10-03 12:00:00+00).\nconst emSP = (valor, formato) => {\n  if (!valor) return '';\n  let data = DateTime.fromISO(valor);\n  if (!data.isValid) data = DateTime.fromSQL(valor);\n  return data.isValid ? data.setZone(FUSO).toFormat(formato) : String(valor);\n};\n\nconst formatarTelefone = (valor) => {\n  const d = String(valor ?? '').replace(/\\D/g, '');\n  if (d.length === 11) return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;\n  if (d.length === 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;\n  return d;\n};\n\n// Uma linha por pedido para a aba \"Novos pedidos\".\nreturn $input.all().map(({ json: p }) => ({\n  json: {\n    'Data (SP)': emSP(p.created_at, 'dd/MM/yyyy HH:mm'),\n    'Pedido': p.numero,\n    'Cliente': p.cliente_nome,\n    'Telefone': formatarTelefone(p.cliente_telefone),\n    'Valor total': Number(p.valor_total),\n    'Observações': p.observacoes ?? '',\n  },\n}));"
      },
