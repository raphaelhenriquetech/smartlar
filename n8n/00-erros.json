    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normaliza o payload do Error Trigger (erro em execução ou erro no próprio trigger).\nconst FUSO = 'America/Sao_Paulo';\nreturn $input.all().map(({ json: e }) => {\n  const execucao = e.execution ?? {};\n  const erro = execucao.error ?? e.trigger?.error ?? {};\n  return {\n    json: {\n      'Data (SP)': $now.setZone(FUSO).toFormat('dd/MM/yyyy HH:mm:ss'),\n      'Workflow': e.workflow?.name ?? '',\n      'Nó': execucao.lastNodeExecuted ?? erro.node?.name ?? '',\n      'Erro': erro.message ?? 'Erro sem mensagem',\n      'Execução': execucao.url ?? '',\n      'Modo': execucao.mode ?? 'trigger',\n    },\n  };\n});"
      },
