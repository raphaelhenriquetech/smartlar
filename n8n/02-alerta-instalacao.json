    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const FUSO = 'America/Sao_Paulo';\n// Aceita ISO (PostgREST: 2026-10-03T12:00:00+00:00) e texto do Postgres (2026-10-03 12:00:00+00).\nconst emSP = (valor, formato) => {\n  if (!valor) return '';\n  let data = DateTime.fromISO(valor);\n  if (!data.isValid) data = DateTime.fromSQL(valor);\n  return data.isValid ? data.setZone(FUSO).toFormat(formato) : String(valor);\n};\n\nconst formatarTelefone = (valor) => {\n  const d = String(valor ?? '').replace(/\\D/g, '');\n  if (d.length === 11) return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;\n  if (d.length === 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;\n  return d;\n};\n\nconst geradoEm = $now.setZone(FUSO).toFormat('dd/MM/yyyy HH:mm');\nreturn $input.all().map(({ json: i }) => ({\n  json: {\n    'Gerado em': geradoEm,\n    'Situação': 'Instalação agendada',\n    'Data da instalação': emSP(i.data_instalacao, 'dd/MM/yyyy'),\n    'Horário': emSP(i.data_instalacao, 'HH:mm'),\n    'Pedido': i.numero,\n    'Cliente': i.cliente_nome,\n    'Endereço': i.cliente_endereco,\n    'Telefone': formatarTelefone(i.cliente_telefone),\n    'Técnico': i.tecnico_nome ?? '',\n  },\n}));"
      },
